{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Worldkeeper",
  "version": "0.2.0",
  "identifier": "app.worldkeeper.desktop",
  "build": {
    "frontendDist": "../desktop/shell",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "RolePlayingGame",
    "shortDescription": "World encyclopedia and D&D campaign manager",
    "longDescription": "A local-first worldbuilding encyclopedia and D&D 5e (2024) campaign manager. Your data stays on this computer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/worldkeeper-node"],
    "resources": {
      "../desktop/build/server/": "server/",
      "../desktop/build/client/": "client/"
    }
  }
}
