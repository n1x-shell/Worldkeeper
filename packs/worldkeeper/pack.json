  },
  "modules": ["thinning", "the-return", "fading-salvage", "setting-treasure", "vaults", "shards", "depths-explorer", "quick-reference", "renown"],
  "importProfile": {
    "about": "How this setting's own archive reads: its folder layout, the wording of its Category and realm fields, and its ID prefixes. Applied to an import that looks like this archive, and to this pack's own content.",
    "detect": ["aetheris_setting_bible", "canonical_entry_locator", "(^|/)worldkeeper_additions/"],
    "eras": ["before-the-cycle", "the-cycle", "before-kaelith", "kaelith", "after-bloom", "unbound", "future"],
    "files": [
      {
        "pattern": "^references/.*setting_bible",
        "kind": "bible"
      },
      {
        "pattern": "^references/",
        "kind": "reference"
      },
      {
        "pattern": "/worked_examples/",
        "kind": "worked_example"
      },
      {
        "pattern": "^manifest\\.md$",
        "kind": "manifest"
      },
      {
        "pattern": "^08_amsel_lore_foundation/",
        "kind": "guide"
      },
      {
        "pattern": "^07_continuity/",
        "kind": "continuity",
        "onlyWithoutRecords": true
      }
    ],
    "locator": "canonical_entry_locator",
    "categoryRules": [
      {
        "pattern": "legacy cross-reference",
        "type": "redirect"
      },
      {
        "pattern": "^register",
        "type": "register"
      },
      {
        "pattern": "^(index|guide|npc directory)",
        "type": "index"
      },
      {
        "pattern": "^world",
        "type": "world"
      },
      {
        "pattern": "^realm",
        "type": "realm"
      },
      {
        "pattern": "^continent",
        "type": "continent"
      },
      {
        "pattern": "^building",
        "type": "building"
      },
      {
        "pattern": "^magic system",
        "type": "magic_system"
      },
      {
        "pattern": "^religion",
        "type": "deity"
      },
      {
        "pattern": "^historical",
        "type": "event"
      },
      {
        "pattern": "^ethereal group",
        "type": "faction"
      },
      {
        "pattern": "^people",
        "type": "people"
      },
      {
        "pattern": "^(shared system|shared rules|travel guide)",
        "type": "system"
      },
      {
        "pattern": "^rule",
        "type": "rule"
      },
      {
        "pattern": "^(adventure|campaign arcs)",
        "type": "adventure_hook"
      }
    ],
    "idTypes": {
      "CON-501": "realm"
    },
    "prefixTypes": {
      "WLD": {
        "type": "world",
        "ids": ["WLD-901"],
        "else": "index"
      },
      "CON": "continent",
      "REG": "region",
      "LOC": "landmark",
      "SET": "settlement",
      "VLT": "vault",
      "KEY": "vault_key",
      "NPC": "npc",
      "FAC": "faction",
      "CLT": "cult",
      "FAM": "family",
      "PPL": "people",
      "CAL": "calling",
      "DEI": "deity",
      "COS": "cosmology",
      "HIS": "event",
      "SHD": "shard",
      "ART": "artifact",
      "ITM": "item",
      "CRE": "creature",
      "RUL": "rule",
      "ETH": {
        "type": "ethereal_domain",
        "category": "^ethereal domain",
        "else": "index"
      },
      "SYS": "system",
      "HOOK": "adventure_hook",
      "DEC": "register",
      "GDE": "index",
      "IDX": "index",
      "CUS": "custom"
    },
    "realmNames": {
      "aetheris": "aetheris",
      "kaelmar": "kaelmar",
      "ethereal": "ethereal"
    },
    "notARealm": "^(both|all|any|every(where)?|multiple|various|n\\/?a|none|unknown|undefined|-|—|cross[- ]realm)\\b",
    "realmFocus": "actual established domain:\\s*([^;]+)",
    "domainRecords": {
      "ETH-501": "hollow-verge",
      "ETH-502": "fields-of-lost-realities",
      "ETH-503": "ossuary-of-kings",
      "ETH-504": "silent-archive",
      "ETH-505": "loom-of-eternity",
      "ETH-506": "citadel-of-the-hidden",
      "ETH-507": "black-horizon"
    },
    "timelineFile": "04_world_timeline\\.md$"
  },
  "cleaning": {
    "about": "Notes in this setting's archive about its own sources (citations, tags, file names, rulebook caveats), hidden outside debug mode. Applied only to records from this pack; the records are never changed.",
    "sourceTag": {
      "pattern": "\\s*\\[(?:SOURCE[- ]PROVIDED[^\\]]*|OPTIONAL[^\\]]*|OUTSIDE[^\\]]*|HOMEBREW[^\\]]*|NEW|PROPOSED[^\\]]*|UNDEFINED[^\\]]*|INFERENCE[^\\]]*|BELIEF[^\\]]*|EXTRAPOLATED[^\\]]*|CANON[^\\]]*|DERIVED[^\\]]*|OFFICIAL[^\\]]*|v\\d+[^\\]]*)\\]",
      "flags": "gi"
    },
    "citation": {
      "pattern": "\\s*\\((?:[AKW]\\s*:[^()]*)\\)|\\s*\\([^()]*\\[[A-Z]{3}-\\d{3}\\][^()]*\\)",
      "flags": "g"
    },
    "sourcePhrases": [
      {
        "pattern": "\\s+as described by the cards",
        "flags": "gi",
        "to": ""
      },
      {
        "pattern": "\\s+from the source\\b",
        "flags": "gi",
        "to": ""
      },
      {
        "pattern": "\\s+in the (?:novel|cards|bible|setting bible)\\b",
        "flags": "gi",
        "to": ""
      },
      {
        "pattern": ",?\\s+called [^,.]+ in the novel",
        "flags": "gi",
        "to": ""
      },
      {
        "pattern": "What the cards say",
        "flags": "g",
        "to": "What is told"
      },
      {
        "pattern": "\\b[Tt]he (\\d+ AB) novel\\b",
        "flags": "g",
        "to": "$1"
      },
      {
        "pattern": "\\s+appear in (?:the )?(?:\\w+ )?character cards as ",
        "flags": "gi",
        "to": " are "
      },
      {
        "pattern": ",?\\s*but the (?:bibles?|books|cards|source) (?:do|does) not say so",
        "flags": "gi",
        "to": ""
      },
      {
        "pattern": "\\bThe source (?:proposes|suggests) representing ",
        "flags": "g",
        "to": "Represent "
      },
      {
        "pattern": "\\bThe source suggests this route for ",
        "flags": "g",
        "to": "This route suits "
      }
    ],
    "metaSentence": {
      "pattern": "\\.md\\b|Setting[_ ]Bible|\\bthe bible\\b|\\bthe source (?:proposes|suggests|gives|says|states)\\b|\\bsetting-facing\\b|official character class|\\brulebooks?\\b|character-build interpretation|\\bverif(?:y|ied)\\b|\\bUNDEFINED\\b|\\bSee [A-Z]{3,4}-\\d{3}|\\bno (?:additional|further) [^.]* (?:assumed|assigned)\\b|\\bdo not (?:assign|place|create|invent)\\b|\\bowner decision\\b|\\bstated (?:flexible )?convention\\b|\\bTome\\b|\\bLore entries\\b|\\bstandalone page\\b|\\bnot a replacement for\\b|\\bauthoritative\\b|\\brule reference\\b|\\bthe (?:cards|bibles|books|Lorebook|GM Lorebook)\\b|\\b(?:cards|books|bibles|Lorebook)'s?\\s|`[^`]*\\/[^`]*`|\\b[A-Z]{3}-\\d{3}[\\u2013-]\\d{3}\\b|\\bsee (?:the )?[^.]*\\b[A-Z]{3}-\\d{3}\\b|\\bbibles?\\b|\\bcharacter cards?\\b|\\bno [^.]*\\bis established\\b|\\bonly [^.]*\\bis established\\b|\\bonly the pressures apparent\\b",
      "flags": "i"
    },
    "sourceOnlyHeading": {
      "pattern": "^(?:undefined|shared-world relationship|cross-entry role link.*|position and map use|limit of the record)$",
      "flags": "i"
    },
    "editorialHeading": {
      "pattern": "^(sources?|references|unspecified fields|tome implementation|review notes|limits( of the source)?|record boundaries|source boundary|use and verification|missing facts|limitations|open questions|unknowns|amsel entry (rule|notes)|use in amsel|status)(\\s*\\[[^\\]]*\\])?$",
      "flags": "i"
    }
  },
  "handbook": {
    "about": "Rules for matching the published Player Handbook: which sections of this pack's records are safe for players.",
    "editorialHeading": {
      "pattern": "^(sources?|references|unspecified fields|tome implementation|review notes|limits( of the source)?|record boundaries|source boundary|use and verification|missing facts|limitations|open questions|unknowns|amsel entry (rule|notes)|use in amsel|status)(\\s*\\[[^\\]]*\\])?$",
      "flags": "i"
    },
    "dmFacingHeading": {
      "pattern": "^(use in play|connections and use|verification boundary|cross-entry role link.*|mechanics note|provenance note|related documents|related|undefined|notes|campaign use|adventure material|attitude toward the party.*|established limits|other possibilities|boundaries)$",
      "flags": "i"
    },
    "bookkeeping": {
      "pattern": "do not (assign|place|create|turn|invent)|without (approval|an owner decision)|\\bAmsel\\b|belongs? in Tome|owner decision",
      "flags": "i"
    },
    "spoilers": [
      {
        "pattern": "\\b(Seed Vault|Mirewell|Arborhold|Cradlehorn|Cinderlock|Anvilreach|Rimeholt|Deepcall|Saltgate|Greyhall|Watchbarrow|Glassmere|Hollowbell)\\b",
        "flags": ""
      },
      {
        "pattern": "Forgotten One|thirteenth (shard|crystal)|Root Core|Seventh Ward|\\[SECRET|GM only",
        "flags": "i"
      }
    ],
    "spoilerExceptions": [
      {
        "pattern": "Hidden Ones",
        "flags": "",
        "exceptIn": "COS-910"
      }
    ]
  }
}
