{
  "name": "worldkeeper",
  "version": "0.9.17",
  "private": true,
  "description": "The Worldkeeper: a local-first worldbuilding encyclopedia and D&D campaign manager.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit && vite build && vite build --config vite.player.config.ts",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "import": "tsx server/src/cli/import.ts",
    "backup": "tsx server/src/cli/backup.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "start:player": "NODE_ENV=production WORLDKEEPER_MODE=player tsx server/src/index.ts",
    "setup": "npm install && npm run build",
    "desktop:prepare": "node scripts/desktop-prepare.mjs",
    "desktop:dev": "node scripts/desktop-prepare.mjs && tauri dev",
    "desktop:build": "node scripts/desktop-prepare.mjs && tauri build",
    "e2e": "node scripts/e2e-smoke.mjs",
    "e2e:first-run": "node scripts/e2e-first-run.mjs",
    "build:player": "vite build --config vite.player.config.ts",
    "lint": "oxlint --type-aware",
    "deadcode": "knip",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^13.0.2",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.77.0",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.6",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "knip": "^6.48.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "postcss": "^8.5.33",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
